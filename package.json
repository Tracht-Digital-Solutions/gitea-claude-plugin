{
  "name": "claude-code-gitea",
  "version": "0.4.0",
  "private": true,
  "description": "Gitea plugin for Claude Code: an MCP server that brings repositories, issues, pull requests, Actions and releases of any Gitea instance into Claude Code.",
  "license": "Apache-2.0",
  "author": "Julian Tracht",
  "homepage": "https://github.com/jtracht/claude-code-gitea#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtracht/claude-code-gitea.git"
  },
  "bugs": {
    "url": "https://github.com/jtracht/claude-code-gitea/issues"
  },
  "keywords": [
    "gitea",
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "model-context-protocol"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project mcp",
    "test:unit": "vitest run --project unit",
    "test:mcp": "vitest run --project mcp",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project mcp --coverage",
    "gitea:up": "node scripts/gitea-test-env.mjs up",
    "gitea:down": "node scripts/gitea-test-env.mjs down",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "smoke": "node scripts/smoke-mcp.mjs",
    "package": "node scripts/package-plugin.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run docs:check && npm test && npm run build && npm run smoke",
    "docs:tools": "tsx scripts/gen-tool-docs.ts",
    "docs:check": "tsx scripts/gen-tool-docs.ts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "diff": "^9.0.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
